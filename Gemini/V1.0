-- Modern Roblox UI Framework (Fixed Text Sizes & All Instances Included)
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local CONFIG_FOLDER = "GhostUI_Configs"

-- Cleanup Existing UI
if CoreGui:FindFirstChild("GhostGui") then
    CoreGui:FindFirstChild("GhostGui"):Destroy()
end

-- Fixed Helper for Clean, Non-Huge Text
local function ApplySafeTextSettings(textObject, fontSize)
    fontSize = fontSize or 12
    textObject.TextScaled = false -- Disable raw auto-scale to prevent giant fonts
    textObject.TextSize = fontSize
    textObject.TextWrapped = true

    -- Safe UITextSizeConstraint backup in case TextScaled is required
    pcall(function()
        local constraint = textObject:FindFirstChildOfClass("UITextSizeConstraint")
        if not constraint then
            constraint = Instance.new("UITextSizeConstraint")
            constraint.Parent = textObject
        end
        constraint.MinFontSize = 8
        constraint.MaxFontSize = fontSize
    end)
end

