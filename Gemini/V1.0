-- 8. SEND NOTIFICATION
function Library:SendNotification(options)
    options = options or {}
    options.Title = options.Title or "Notification"
    options.Message = options.Message or ""
    options.Duration = options.Duration or 4

    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(1, 0, 0, 48)
    NotifFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    NotifFrame.Parent = NotificationHolder

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = NotifFrame

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(1, -16, 0, 18)
    TitleLabel.Position = UDim2.new(0, 10, 0, 4)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = options.Title
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = NotifFrame
    ApplySafeTextSettings(TitleLabel, 11)

    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = UDim2.new(1, -16, 0, 20)
    MsgLabel.Position = UDim2.new(0, 10, 0, 22)
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Text = options.Message
    MsgLabel.Font = Enum.Font.Gotham
    MsgLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.Parent = NotifFrame
    ApplySafeTextSettings(MsgLabel, 10)

    task.delay(options.Duration, function()
        if NotifFrame then NotifFrame:Destroy() end
    end)
end

return Library
