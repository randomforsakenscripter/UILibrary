ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
ToggleBtn.Parent = MainFrame
ApplySafeTextSettings(ToggleBtn, 12)

local MAX_CONTAINER_HEIGHT = 300

-- Scrolling Container
local Container = Instance.new("ScrollingFrame")
Container.Name = "ContentsFrame"
Container.Size = UDim2.new(1, 0, 0, 0)
Container.Position = UDim2.new(0, 0, 1, 5)
Container.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
Container.BorderSizePixel = 0
Container.ClipsDescendants = true
Container.Visible = false
Container.ScrollBarThickness = 4
Container.ScrollBarImageColor3 = Color3.fromRGB(0, 170, 255)
Container.CanvasSize = UDim2.new(0, 0, 0, 0)
Container.Parent = MainFrame

local ContainerCorner = Instance.new("UICorner")
ContainerCorner.CornerRadius = UDim.new(0, 8)
ContainerCorner.Parent = Container

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = Container
UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
UIListLayout.Padding = UDim.new(0, 6)

local UIPadding = Instance.new("UIPadding")
UIPadding.Parent = Container
UIPadding.PaddingTop = UDim.new(0, 6)
UIPadding.PaddingBottom = UDim.new(0, 6)
UIPadding.PaddingLeft = UDim.new(0, 8)
UIPadding.PaddingRight = UDim.new(0, 10)

local function UpdateContainerSize()
    local contentHeight = UIListLayout.AbsoluteContentSize.Y + 14
    Container.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
    
    local targetHeight = math.min(contentHeight, MAX_CONTAINER_HEIGHT)
    if Container.Visible then
        TweenService:Create(Container, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, targetHeight)
        }):Play()
    end
end
UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateContainerSize)

local isExpanded = false
ToggleBtn.MouseButton1Click:Connect(function()
    isExpanded = not isExpanded
    ToggleBtn.Text = isExpanded and "^" or "v"
    
    if isExpanded then
        Container.Visible = true
        UpdateContainerSize()
    else
        local tween = TweenService:Create(Container, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(1, 0, 0, 0)
        })
        tween:Play()
        tween.Completed:Connect(function()
            if not isExpanded then Container.Visible = false end
        end)
    end
end)

----------------------------------------------------
-- LIBRARY API
----------------------------------------------------
local Library = {}
local RegisteredElements = {}

function Library:SetTitle(newTitle)
    TitleLabel.Text = tostring(newTitle)
end

local function EnsureConfigFolder()
    if isfolder and makefolder then
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
    end
end

function Library:SaveConfig(fileName)
    fileName = (fileName == "" or not fileName) and "default" or fileName
    if not string.find(fileName, "%.json$") then fileName = fileName .. ".json" end

    EnsureConfigFolder()
    local path = CONFIG_FOLDER .. "/" .. fileName

    local saveData = { Title = TitleLabel.Text, Elements = {} }
    for name, elem in pairs(RegisteredElements) do
        if elem.Options and elem.Options.Value ~= nil then
            saveData.Elements[name] = elem.Options.Value
        end
    end

    if writefile then
        writefile(path, HttpService:JSONEncode(saveData))
        Library:SendNotification({ Title = "Config Saved", Message = "Saved: " .. fileName, Duration = 3 })
    end
end

function Library:LoadConfig(fileName)
    fileName = (fileName == "" or not fileName) and "default" or fileName
    if not string.find(fileName, "%.json$") then fileName = fileName .. ".json" end

    local path = CONFIG_FOLDER .. "/" .. fileName
    if isfile and readfile and isfile(path) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if success and decoded then
            if decoded.Title then Library:SetTitle(decoded.Title) end
            if decoded.Elements then
                for name, val in pairs(decoded.Elements) do
                    if RegisteredElements[name] then RegisteredElements[name]:Set({Value = val}) end
                end
            end
            Library:SendNotification({ Title = "Config Loaded", Message = "Loaded: " .. fileName, Duration = 3 })
        end
    end
end

-- 1. ADD TITLE EDITOR
function Library:AddTitleEditor(options)
    options = options or {}
    options.Name = options.Name or "Menu Title"
    options.Placeholder = options.Placeholder or "Type new title..."
    
    local Frame = Instance.new("Frame")
    Frame.Name = "TitleEditor_" .. options.Name
    Frame.Size = UDim2.new(1, 0, 0, 34)
    Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    Frame.Parent = Container

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Frame

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0.45, -10, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = options.Name
    Label.Font = Enum.Font.GothamMedium
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    ApplySafeTextSettings(Label, 11)

    local Input = Instance.new("TextBox")
    Input.Size = UDim2.new(0.55, -10, 0, 22)
    Input.Position = UDim2.new(0.45, 0, 0.5, -11)
    Input.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    Input.Text = TitleLabel.Text
    Input.PlaceholderText = options.Placeholder
    Input.Font = Enum.Font.Gotham
    Input.TextColor3 = Color3.fromRGB(255, 255, 255)
    Input.Parent = Frame
    ApplySafeTextSettings(Input, 11)

    local InputCorner = Instance.new("UICorner")
    InputCorner.CornerRadius = UDim.new(0, 4)
    InputCorner.Parent = Input

    local conn = Input.FocusLost:Connect(function()
        if Input.Text ~= "" then Library:SetTitle(Input.Text) end
    end)

    return {Instance = Frame, Delete = function() conn:Disconnect(); Frame:Destroy(); UpdateContainerSize() end}
end

-- 2. ADD BUTTON
function Library:AddButton(options)
    options = options or {}
    options.Name = options.Name or "Button"
    options.Callback = options.Callback or function() end

    local Button = Instance.new("TextButton")
